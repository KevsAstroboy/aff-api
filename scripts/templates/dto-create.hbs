import { ApiProperty, ApiPropertyOptional } from '@nestjs/swagger';
import {
  {{#if hasString}}IsString,
  {{/if}}
  {{#if hasInt}}IsInt,
  {{/if}}
  {{#if hasBoolean}}IsBoolean,
  {{/if}}
  IsOptional{{#if hasString}}, MaxLength{{/if}}
} from 'class-validator';

export class Create{{modelName}}Dto {
{{#each scalars}}
{{#if isRequired}}
  @ApiProperty({ example: {{example}} })
{{/if}}
{{#if isOptional}}
  @ApiPropertyOptional({ example: {{example}} })
{{/if}}
{{#if isString}}
  @IsString()
  @MaxLength({{maxLength}})
{{/if}}
{{#if isInt}}
  @IsInt()
{{/if}}
{{#if isBoolean}}
  @IsBoolean()
{{/if}}
{{#if isOptional}}
  @IsOptional()
{{/if}}
{{#if isRequired}}
  {{name}}: {{tsType}};
{{/if}}
{{#if isOptional}}
  {{name}}?: {{tsType}};
{{/if}}

{{/each}}
}
